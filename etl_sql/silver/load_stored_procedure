/*
===============================================================================
Stored Procedure: Load Silver Layer (Bronze -> Silver)
===============================================================================
Script Purpose:
    This stored procedure performs the ETL (Extract, Transform, Load) process to 
    populate the 'silver' schema tables from the 'bronze' schema.
	Actions Performed:
		- Truncates Silver tables.
		- Inserts transformed and cleansed data from Bronze into Silver tables.
		
Parameters:
    None. 
	  This stored procedure does not accept any parameters or return any values.

Usage Example:
    EXEC silver.load_
===============================================================================
*/

DROP PROCEDURE silver.load_

CREATE OR ALTER PROCEDURE silver.load_ AS
BEGIN
	DECLARE @start_batch_time AS DATETIME, @end_batch_time AS DATETIME

	SET @start_batch_time = GETDATE();
	BEGIN TRY
		PRINT'===================================';
		PRINT'Loading the Silver Layer';
		PRINT'===================================';

	
		TRUNCATE TABLE silver.household

		PRINT'>>>Inserting Data Into Table: silver.household';
		INSERT INTO silver.household(
			household_key,
			sector,
			insurance_premium,
			usual_monthly_consumer_exp
		)
		SELECT
		fsu_serial_no+'-'+second_stage_stratum+'-'+household_id as household_key,
		CASE WHEN sector=1 THEN 'Rural'
		ELSE 'Urban'
		END sector,
		insurance_premium,
		CASE WHEN usual_monthly_consumer_exp <= 50000 THEN 'Low'
			 WHEN usual_monthly_consumer_exp BETWEEN 50001 AND 100000 THEN 'Lower Middle'
			 WHEN usual_monthly_consumer_exp BETWEEN 100001 AND 200000 THEN 'Upper Middle'
			 ELSE 'High'
        END usual_monthly_consumer_exp
		FROM bronze.household
		

		
		
		TRUNCATE TABLE silver.person

		PRINT'>>>Inserting Data Into Table: silver.person';
		INSERT INTO silver.person(
		    household_key,
			person_key,
			gender,
			age,
			no_times_hospitalized,
			whether_insured,
			mult,
			state_id
		)
		SELECT
		fsu_serial_no+'-'+second_stage_stratum+'-'+household_id as household_key,
		fsu_serial_no+'-'+second_stage_stratum+'-'+household_id+'-'+person_id as person_key,
		CASE WHEN gender = 1 THEN 'Male'
			 WHEN gender = 2 THEN 'Female'
			 WHEN gender = 3 THEN 'Transgender'
		ELSE 'n/a'
		END gender,
		CASE WHEN age<=18 THEN '0-17'
			 WHEN age BETWEEN 18 AND 40 THEN '18-39'
			 WHEN age BETWEEN 40 AND 59 THEN '40-59'
		ELSE '>= 60'
		END age,
		ISNULL(no_times_hospitalized,0),
		CASE WHEN whether_insured IN (1,2) THEN 'Govt_scheme'
			 WHEN whether_insured IN (3,4,5,6,7) THEN 'Employer_insurance'
			 WHEN whether_insured = 10 THEN 'Private'
			 ELSE 'No'		
		END whether_insured,
		mult,
		state_id
	    FROM bronze.person
		


		
		TRUNCATE TABLE silver.hospitalisation

		PRINT'>>>Inserting Data Into Table: silver.hospitalisation';
		INSERT INTO silver.hospitalisation(
			household_key,
	        person_key,
			hospitalisation_key,
			care_type,
			expenditure,
			amount_covered,
			major_source_spending,
			nature_ailment,
			state_id,
			mult
		)
		SELECT
		fsu_serial_no+'-'+second_stage_stratum+'-'+household_id as household_key,
		fsu_serial_no+'-'+second_stage_stratum+'-'+household_id+'-'+person_id as person_key,
		fsu_serial_no+'-'+second_stage_stratum+'-'+household_id+'-'+person_id+'-'+hospitalization_id as hospitalisation_key,

		CASE WHEN care_type = 1 THEN 'Govt.'
	    WHEN care_type = 3 THEN 'Private'
	    ELSE 'Others'
        END care_type,
        expenditure,
		amount_covered,
		CASE WHEN major_source_spending IN (1,3) THEN 'Income,Savings & Asset'
			 WHEN major_source_spending IN (2,4) THEN 'Borrowing'
			 ELSE 'Others'
		END major_source_spending,
		CASE WHEN nature_ailment IN (01, 02, 03, 05, 07, 08, 13, 15, 16, 17, 21, 22, 25, 26, 35, 36, 39, 43, 50, 51, 52, 54, 55, 56, 57, 58, 60) THEN 'High risk'
			 WHEN nature_ailment IN (06, 09, 10, 11, 14, 18, 19, 20, 23, 24, 27, 29, 30, 31, 33, 34, 38, 41, 42, 45, 47, 48, 49, 53, 59) THEN 'Medium risk'
			 WHEN nature_ailment IN (04, 12, 28, 32, 37, 40, 44, 46, 61, 62) THEN 'Low risk'
			 WHEN nature_ailment IN (87, 88, 89) THEN 'Childbirth realted'
			 ELSE 'None'
		END nature_ailment,
			state_id,
			mult
		FROM bronze.hospitalisation



		
		TRUNCATE TABLE silver.patient

		PRINT'>>>Inserting Data Into Table: silver.patient';
		INSERT INTO silver.patient(
			 household_key,
			 person_key,
		     non_hospitalisation_key,
			 care_type,
			 total_expenditure,
			 amount_covered,
			 major_source_spending,
			 nature_ailment,
			 state_id,
			 mult
		)
		SELECT
		fsu_serial_no+'-'+second_stage_stratum+'-'+household_id as household_key,
		fsu_serial_no+'-'+second_stage_stratum+'-'+household_id+'-'+person_id as person_key,
		fsu_serial_no+'-'+second_stage_stratum+'-'+household_id+'-'+person_id+'-'+opd_id as non_hospitalisation_key,
		CASE WHEN care_type=1 THEN 'Govt.'
			 WHEN care_type IN (3,4) THEN 'Private'
			 ELSE 'Others'
        END care_type,
    	total_expenditure,
		amount_covered,
		CASE WHEN major_source_spending IN (1,3) THEN 'Income,Savings & Asset'
			 WHEN major_source_spending IN (2,4) THEN 'Borrowing'
			 ELSE 'Others'
		END major_source_spending,
		CASE WHEN nature_ailment IN (01, 02, 03, 05, 07, 08, 13, 15, 16, 17, 21, 22, 25, 26, 35, 36, 39, 43, 50, 51, 52, 54, 55, 56, 57, 58, 60) THEN 'High risk'
			 WHEN nature_ailment IN (06, 09, 10, 11, 14, 18, 19, 20, 23, 24, 27, 29, 30, 31, 33, 34, 38, 41, 42, 45, 47, 48, 49, 53, 59) THEN 'Medium risk'
			 WHEN nature_ailment IN (04, 12, 28, 32, 37, 40, 44, 46, 61, 62) THEN 'Low risk'
			 WHEN nature_ailment IN (87, 88, 89) THEN 'Childbirth realted'
			 ELSE 'None'
		END nature_ailment,
			state_id,
			mult
		FROM bronze.patient

		
		TRUNCATE TABLE silver.state_

		PRINT'>>>Inserting Data Into Table: silver.state_';
		INSERT INTO silver.state_(
			st_ut,
			state_name,
			region
		)
		SELECT
		st_ut,
		state_name,
		CASE WHEN st_ut IN (01, 02, 03, 04, 06, 07, 37) THEN 'North'
			 WHEN st_ut IN (10, 19, 20, 21, 11, 12, 13, 14, 15, 16, 17, 18) THEN 'East'
			 WHEN st_ut IN (24, 25, 27, 30, 08) THEN 'West'
			 WHEN st_ut IN (28, 29, 31, 32, 33, 34, 35, 36) THEN 'South'
			 ELSE 'Central'
		END region
		FROM bronze.state_


SET @end_batch_time = GETDATE();
		PRINT'>>>Loading Duration of Whole Batch:' +CAST(DATEDIFF(second,@start_batch_time,@end_batch_time)AS NVARCHAR) +'seconds';

	END TRY
	BEGIN CATCH
		PRINT'====================================================';
		PRINT'An Error Occured During The Loading Of Silver Layer';
		PRINT 'Error Message' + ':' + ERROR_MESSAGE();
        	PRINT 'Error Number' + ':' + CAST(ERROR_NUMBER() AS NVARCHAR);
		PRINT 'Error State' + ':' + CAST(ERROR_STATE() AS NVARCHAR); 
		PRINT'====================================================';
	END CATCH
END
