/*
*******************************
===============================
Creating Tables in Silver Layer
===============================
*******************************
*/

DROP TABLE IF EXISTS silver.household;
CREATE TABLE silver.household (
	household_key NVARCHAR(60),
	sector NVARCHAR(60),
	insurance_premium INT,
	usual_monthly_consumer_exp NVARCHAR(60),
	hlc_create_date DATETIME2 DEFAULT GETDATE()
)	


DROP TABLE IF EXISTS silver.person;
CREATE TABLE silver.person (
    household_key NVARCHAR(60),
	person_key NVARCHAR(60),
	gender NVARCHAR(60),
	age NVARCHAR (60),
	no_times_hospitalized INT,
	whether_insured NVARCHAR(60),
	mult INT,
	state_id NVARCHAR(60),
	hlc_create_date DATETIME2 DEFAULT GETDATE()
)

DROP TABLE IF EXISTS silver.hospitalisation;
CREATE TABLE silver.hospitalisation(
	household_key NVARCHAR(60),
	person_key NVARCHAR(60),
	hospitalisation_key NVARCHAR(60),
	care_type NVARCHAR(60),
	expenditure FLOAT,
	amount_covered FLOAT,
	major_source_spending NVARCHAR(60),
	nature_ailment NVARCHAR(60),
	state_id NVARCHAR(60),
	mult INT,
	hlc_create_date DATETIME2 DEFAULT GETDATE()
)


DROP TABLE IF EXISTS silver.patient;
CREATE TABLE silver.patient(
    household_key NVARCHAR(60),
	person_key NVARCHAR(60),
	non_hospitalisation_key NVARCHAR(60),
	care_type NVARCHAR(60),
	total_expenditure FLOAT,
	amount_covered FLOAT,
	major_source_spending NVARCHAR(60),
	nature_ailment NVARCHAR(60),
	state_id NVARCHAR(60),
	mult INT,
	hlc_create_date DATETIME2 DEFAULT GETDATE()
)

DROP TABLE IF EXISTS silver.state_;
CREATE TABLE silver.state_(
	st_ut NVARCHAR(60),
	state_name NVARCHAR(60),
	region NVARCHAR(60),
	hlc_create_date DATETIME2 DEFAULT GETDATE()
)
